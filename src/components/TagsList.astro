---
interface Props {
    tags: string[];
    counts?: Record<string, number>;
}

const { tags, counts } = Astro.props;
---

<ul class="tags">
    {
        [...tags].sort().map((tag) => (
            <li>
                <a href={`/tags/${tag}`} class="tag kv-notch">
                    <span class="hash">#</span>
                    {tag}
                    {counts?.[tag] !== undefined && (
                        <span class="count">{counts[tag]}</span>
                    )}
                </a>
            </li>
        ))
    }
</ul>

<style>
    .tags {
        display: flex;
        flex-wrap: wrap;
        gap: 0.4rem;
        margin: 0;
        padding: 0;
        list-style: none;
    }

    .tags li {
        margin: 0;
        padding: 0;
        list-style: none;
    }

    .tag {
        display: inline-flex;
        align-items: center;
        gap: 0.1em;
        padding: 0.15rem 0.55rem;
        border: 1px solid var(--kv-border);
        background: var(--kv-surface);
        color: var(--kv-muted);
        font-family: var(--kv-font-mono);
        font-size: var(--kv-text-xs);
        line-height: 1.5;
        --notch: 6px;
        transition:
            color var(--kv-transition),
            border-color var(--kv-transition),
            background var(--kv-transition);
    }

    .hash {
        color: var(--kv-accent);
    }

    .count {
        margin-left: 0.4em;
        opacity: 0.7;
    }

    .tag:hover {
        color: var(--kv-accent-ink);
        background: var(--kv-accent-fill);
        border-color: var(--kv-accent-fill);
    }

    .tag:hover .hash {
        color: inherit;
    }
</style>
