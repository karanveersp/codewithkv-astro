---

---

<button id="themeToggle" type="button" aria-label="Toggle light and dark theme">
    <i id="sunIcon" class="bx bx-sun"></i>
    <i id="moonIcon" class="bx bxs-moon"></i>
</button>

<style>
    #themeToggle {
        border: none;
        background: none;
        padding: 0;
        --pico-box-shadow: none;
        transition: transform 0.4s ease;
        --icon-color-light: var(--kv-muted);
        --icon-color-dark: var(--kv-muted);
        cursor: pointer;
        line-height: 1;
        display: inline-flex;
        align-items: center;
        margin: 0;
        vertical-align: middle;
    }

    #themeToggle:hover {
        color: var(--pico-primary-hover);
    }

    .bx {
        font-size: 20px;
        vertical-align: middle;
    }

    #sunIcon {
        color: var(--icon-color-light);
    }

    #moonIcon {
        display: none; /* Default hidden */
        color: var(--icon-color-dark);
    }

    #themeToggle:hover #moonIcon,
    #themeToggle:hover #sunIcon {
        color: var(--pico-primary-hover);
    }

    :global(.dark) #sunIcon {
        display: none;
    }

    :global(.dark) #moonIcon {
        display: inline-block;
    }
</style>

<script is:inline>
const setTheme = () => {
    function enableTheme(value) {
        const element = document.documentElement;
        element.setAttribute("data-theme", value);
        document.documentElement.classList.add(value);
        document.documentElement.classList.remove(
            value === "dark" ? "light" : "dark",
        );
        localStorage.setItem("theme", value);
    }
    const themeToggle = document.getElementById("themeToggle");
    let currentTheme = (() => {
        if (
            typeof localStorage !== "undefined" &&
            localStorage.getItem("theme")
        ) {
            return localStorage.getItem("theme");
        }
        if (window.matchMedia("(prefers-color-scheme: dark)").matches) {
            return "dark";
        }
        return "light";
    })();

    if (currentTheme === "light") {
        enableTheme("light");
    } else {
        enableTheme("dark");
    }

    themeToggle.addEventListener("click", () => {
        if (document.documentElement.hasAttribute("data-theme")) {
            currentTheme =
                document.documentElement.getAttribute("data-theme");
        }
        if (currentTheme === "light") {
            enableTheme("dark");
        } else {
            enableTheme("light");
        }
    });
};

setTheme();
document.addEventListener("astro:after-swap", setTheme);
</script>
