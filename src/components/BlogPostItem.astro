---
import type { CollectionEntry } from "astro:content";
import FormattedDate from "./FormattedDate.astro";
import TagsList from "./TagsList.astro";

interface Props {
    post: CollectionEntry<"blog">;
}

const { post } = Astro.props;
---

<article class="post-item">
    <div class="date">
        <FormattedDate date={post.data.date} />
    </div>
    <div class="body">
        <h3 class="title">
            <a href={`/${post.slug}/`} class="kv-mark">{post.data.title}</a>
        </h3>
        <p class="description">{post.data.description}</p>
        <TagsList tags={post.data.tags} />
    </div>
</article>

<style>
    .post-item {
        display: grid;
        grid-template-columns: 7.5rem 1fr;
        gap: 1.25rem;
        padding: 1.5rem 0;
        border-bottom: 1px solid var(--kv-border);
    }

    .date {
        padding-top: 0.3rem;
        color: var(--kv-muted);
        font-family: var(--kv-font-mono);
        font-size: var(--kv-text-sm);
        white-space: nowrap;
    }

    .title {
        margin: 0 0 0.4rem;
        font-size: var(--kv-text-xl);
        line-height: 1.3;
    }

    /* Highlighter link (utilities.css): heading-colored, no mark until hover. */
    .title a {
        --mark-color: var(--kv-heading);
        --mark-rest: 0% 2px;
    }

    .description {
        margin: 0 0 0.75rem;
        color: var(--kv-muted);
        font-size: var(--kv-text-md);
    }

    @media (max-width: 600px) {
        .post-item {
            grid-template-columns: 1fr;
            gap: 0.3rem;
        }
        .date {
            padding-top: 0;
        }
    }
</style>
