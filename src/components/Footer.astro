<script>
    function updateYear() {
        const yearSpan = document.getElementById("year");
        if (yearSpan !== null) {
            yearSpan.textContent = new Date().getFullYear().toString();
        }
    }
    updateYear();
    document.addEventListener("astro:after-swap", updateYear);
</script>
